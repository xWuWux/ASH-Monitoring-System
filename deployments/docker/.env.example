# Copy to .env in this directory (deployments/docker/) before running
# `docker-compose up`. All variables are required — docker-compose.yml
# has no built-in default for any of them, so an unset value fails the run
# immediately with a clear error instead of silently starting with a
# well-known, source-visible default password/secret.
#
# Generate strong secret values with, e.g.:
#   openssl rand -hex 32

ASH_DB_PASSWORD=
ASH_JWT_SECRET=

# Admin login for the API (POST /api/v1/auth/token). ASH_ADMIN_PASS should
# be a generated secret, not a memorable password -- there is no user store
# behind this, it's a single shared credential.
ASH_ADMIN_USER=
ASH_ADMIN_PASS=

# Optional: additional roles the API will issue tokens for. Leave unset and
# that role simply cannot log in -- there is no fallback/default credential
# for any role.
# ASH_ANALYST_USER=
# ASH_ANALYST_PASS=
# ASH_READONLY_USER=
# ASH_READONLY_PASS=

# Optional structured-log level for the consumer and API. Allowed values:
# DEBUG, INFO, WARNING, ERROR, CRITICAL.
# ASH_LOG_LEVEL=INFO

# Optional API metrics endpoint. It is fail-closed: enabling it without a
# token makes /metrics return 401, and it stays 404 when disabled. Generate
# the token with `openssl rand -hex 32`; the optional monitoring stack uses it
# as a bearer token.
# ASH_METRICS_ENABLED=false
# ASH_METRICS_TOKEN=

# Optional distributed tracing. Disabled by default. Enabling it REQUIRES
# ASH_OTLP_ENDPOINT to be a full OTLP/HTTP traces URL (http or https, no
# credentials in the URL); startup fails rather than dropping spans if it
# is empty. ASH_TRACING_SAMPLE_RATIO is 0.0-1.0 (default 1.0); a sampled
# upstream traceparent always wins.
# ASH_TRACING_ENABLED=false
# ASH_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# ASH_TRACING_SAMPLE_RATIO=1.0

# Optional OTLP log export for the monitoring stack. Independent of tracing
# and disabled by default. Enabling it REQUIRES a full OTLP/HTTP logs URL
# (http or https, no credentials); startup fails rather than dropping logs
# if it is empty. stdout logging is always kept.
# ASH_LOG_OTLP_ENABLED=false
# ASH_OTLP_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs

# ── Optional monitoring stack (--profile monitoring) ─────────────────────
# These values are consumed by scripts/monitoring-init.sh and the Compose
# services in the `monitoring` profile. They are not needed for the default
# Kafka/PostgreSQL/consumer/API stack. See docs/OBSERVABILITY.md.
#
# API /metrics is fail-closed. The init script refuses to render the stack
# unless metrics are enabled and the bearer token is at least 16 characters
# from [A-Za-z0-9._~+/=-]. Generate one with `openssl rand -hex 32`; the same
# value is mounted into Prometheus as a 0600 credentials file.
# ASH_METRICS_ENABLED=true
# ASH_METRICS_TOKEN=

# Alert delivery destination. REQUIRED when the monitoring profile is used:
# an absolute http/https URL with a host, no userinfo (credentials in the URL
# would be committed and logged), quotes, backslashes, or control characters.
# The init script renders it into Alertmanager's 0600 config; a missing value
# is a hard failure rather than a silently discarding null receiver.
# ASH_ALERTMANAGER_WEBHOOK_URL=https://alerts.example.invalid/ash

# Grafana admin password. Optional: when unset, init generates a random one
# and writes it 0600 to the runtime directory. If provided it must be at least
# 12 characters with no control characters. Anonymous access and sign-up are
# disabled.
# ASH_GRAFANA_ADMIN_PASSWORD=

# Optional absolute directories for rendered secrets and persistent state.
# Both default to /var/lib/ash-monitoring (runtime under .../runtime). They
# must be absolute and not `/`; runtime is created 0711 and secrets 0600,
# state directories 0750 with the container UIDs. Override them consistently
# in the env file and in any manual `docker compose` invocation.
# ASH_MONITORING_RUNTIME_DIR=/var/lib/ash-monitoring/runtime
# ASH_MONITORING_DATA_DIR=/var/lib/ash-monitoring
