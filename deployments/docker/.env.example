# Copy to .env in this directory (deployments/docker/) before running
# `docker-compose up`. Both variables are required — docker-compose.yml
# has no built-in default for either, so an unset value fails the run
# immediately with a clear error instead of silently starting with a
# well-known, source-visible default password/secret.
#
# Generate strong values with, e.g.:
#   openssl rand -hex 32

ASH_DB_PASSWORD=
ASH_JWT_SECRET=
