FROM python:3.12-slim

RUN useradd -r -u 1000 -s /bin/false ash && \
    mkdir -p /var/log/ash /var/archive/ash /etc/ash && \
    chown -R ash:ash /var/log/ash /var/archive/ash

COPY src/consumer/requirements.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY src/consumer/ /usr/local/lib/ash/
COPY config/consumer.conf.example /etc/ash/consumer.conf
COPY config/alert_rules.json.example /etc/ash/alert_rules.json

USER ash
EXPOSE 9090

CMD ["python3", "/usr/local/lib/ash/ash-consumer.py", "/etc/ash/consumer.conf"]
