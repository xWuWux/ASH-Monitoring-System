# ASH Alertmanager template.
#
# scripts/monitoring-init.sh replaces the single webhook URL placeholder with
# the validated value of ASH_ALERTMANAGER_WEBHOOK_URL and writes the rendered
# file with mode 0600. A missing or invalid URL is a hard failure: this stack
# must never ship a null receiver that silently discards every page.
global:
  resolve_timeout: 5m

route:
  receiver: ash-webhook
  group_by: [alertname, cluster, component]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - matchers:
        - severity="critical"
      receiver: ash-webhook
      repeat_interval: 1h

receivers:
  - name: ash-webhook
    webhook_configs:
      - url: "__ASH_ALERTMANAGER_WEBHOOK_URL__"
        send_resolved: true
        max_alerts: 0

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: [alertname, cluster, component]
