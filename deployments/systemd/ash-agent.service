[Unit]
Description=ASH Shell Monitoring Agent
After=network.target local-fs.target auditd.service
Wants=auditd.service

[Service]
# Type=notify: the agent sends READY=1 after initialization, then a
# dedicated helper sends WATCHDOG=1 every ASH_WATCHDOG_INTERVAL seconds
# (default 10, below the 30s timeout). An idle host no longer looks dead.
Type=notify
User=root
Group=root
ExecStartPre=/bin/mkdir -p /var/log/ash /var/spool/ash /tmp/ash
ExecStartPre=/bin/chmod 750 /var/log/ash /var/spool/ash
ExecStartPre=/bin/chmod 700 /tmp/ash
ExecStart=/usr/local/bin/ash-agent
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Watchdog — agent must notify every 30s or systemd restarts it
WatchdogSec=30
NotifyAccess=all
Environment=ASH_WATCHDOG_INTERVAL=10

# Environment
Environment=ASH_CONFIG_DIR=/etc/ash
Environment=ASH_LOG_DIR=/var/log/ash
Environment=ASH_SPOOL_DIR=/var/spool/ash

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/log/ash /var/spool/ash /tmp/ash /var/log/audit
PrivateTmp=false
NoNewPrivileges=true
# CAP_SYS_PTRACE was previously granted here but nothing in ash-agent.sh
# uses ptrace; dropped per least-privilege (it would let a compromised
# agent process attach to and read/write arbitrary other processes'
# memory, which is well beyond what auditd-tailing/inotify/hash-chaining
# require).
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_AUDIT_READ

[Install]
WantedBy=multi-user.target
