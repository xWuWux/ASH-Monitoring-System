[Unit]
Description=ASH Shell Monitoring Agent
After=network.target local-fs.target auditd.service
Wants=auditd.service

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/bin/mkdir -p /var/log/ash /var/spool/ash /tmp/ash
ExecStartPre=/bin/chmod 750 /var/log/ash /var/spool/ash
ExecStartPre=/bin/chmod 700 /tmp/ash
ExecStart=/usr/local/bin/ash-agent
Restart=always
RestartSec=5
StartLimitBurst=5
StartLimitIntervalSec=60

# Watchdog — agent must notify every 30s or systemd restarts it
WatchdogSec=30
NotifyAccess=all

# Environment
Environment=ASH_CONFIG_DIR=/etc/ash
Environment=ASH_LOG_DIR=/var/log/ash
Environment=ASH_SPOOL_DIR=/var/spool/ash

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/log/ash /var/spool/ash /tmp/ash /var/log/audit
PrivateTmp=false
NoNewPrivileges=false
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_AUDIT_READ CAP_SYS_PTRACE

[Install]
WantedBy=multi-user.target
