[Unit]
Description=ASH Kafka Consumer and Log Processor
After=network.target kafka.service postgresql.service
Wants=kafka.service postgresql.service

[Service]
Type=simple
User=ash
Group=ash
ExecStart=/usr/local/bin/ash-consumer /etc/ash/consumer.conf
Restart=always
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=120

Environment=PYTHONPATH=/usr/local/lib/python3/dist-packages

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/log/ash /var/archive/ash
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
