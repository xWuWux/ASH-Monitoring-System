[Unit]
Description=ASH Kafka Consumer and Log Processor
After=network.target kafka.service postgresql.service
Wants=kafka.service postgresql.service

[Service]
# Type=notify: ash-consumer sends READY=1 after initialization and the
# observability-listener attempt, then WATCHDOG=1 every 10s. Readiness
# details (database/flush state) stay on /health/ready because a process can
# be healthy while PostgreSQL is temporarily unavailable.
# Previously systemd treated a process that had not connected to anything as
# started, and no watchdog existed at all.
Type=notify
NotifyAccess=main
WatchdogSec=60
# Startup includes bounded PostgreSQL (3 attempts) and Kafka (5 attempts)
# retry loops. This must exceed their combined backoff, or systemd kills a
# process that is still correctly retrying.
TimeoutStartSec=180
User=ash
Group=ash
ExecStart=/usr/local/bin/ash-consumer /etc/ash/consumer.conf
Restart=always
RestartSec=10
StartLimitBurst=3
StartLimitIntervalSec=120

# Shared modules (ash_observability/ash_alerting) live in lib/ash; the
# dist-packages entry supports distro-installed psycopg2/kafka packages.
Environment=PYTHONPATH=/usr/local/lib/ash:/usr/local/lib/python3/dist-packages
Environment=ASH_LOG_LEVEL=INFO
# Loopback-only by default; Prometheus on the same host can scrape it.
Environment=ASH_METRICS_HOST=127.0.0.1
# Tracing is opt-in. To enable it, add a drop-in with
# ASH_TRACING_ENABLED=true and a full OTLP/HTTP URL in ASH_OTLP_ENDPOINT,
# for example http://127.0.0.1:4318/v1/traces. Enabling tracing without an
# endpoint is a deliberate startup failure.
Environment=ASH_TRACING_ENABLED=false
Environment=ASH_TRACING_SAMPLE_RATIO=1.0
# OTLP log export is independent of tracing and off by default. To enable
# it, add ASH_LOG_OTLP_ENABLED=true and a full OTLP/HTTP logs URL in
# ASH_OTLP_LOGS_ENDPOINT (for example http://127.0.0.1:4318/v1/logs) via a
# drop-in. Enabling it without an endpoint is a deliberate startup failure.
Environment=ASH_LOG_OTLP_ENABLED=false

# Security hardening
ProtectSystem=strict
ReadWritePaths=/var/log/ash /var/archive/ash
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
