[Unit]
Description=ASH REST API Server
After=network.target postgresql.service ash-consumer.service
Wants=postgresql.service

[Service]
Type=simple
User=ash
Group=ash
# Gunicorn, not Flask's development server: four sync workers, the same
# process model as the container image. The metrics mmap directory is a
# runtime directory so ProtectSystem=strict does not block writes and the
# contents disappear on stop/start.
ExecStart=/usr/bin/env gunicorn \
    --config /usr/local/lib/ash/gunicorn.conf.py \
    --bind 127.0.0.1:${ASH_API_PORT} \
    --workers 4 \
    --timeout 120 \
    --chdir /usr/local/lib/ash \
    api_server:app
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

RuntimeDirectory=ash-prometheus
RuntimeDirectoryMode=0750
Environment=PROMETHEUS_MULTIPROC_DIR=/run/ash-prometheus
Environment=ASH_LOG_LEVEL=INFO
# Metrics stay off until the monitoring stack is configured and
# ASH_METRICS_TOKEN is added to /etc/ash/api.env.
Environment=ASH_METRICS_ENABLED=false
# Tracing is opt-in. Add ASH_TRACING_ENABLED=true and a full OTLP/HTTP URL
# in ASH_OTLP_ENDPOINT to /etc/ash/api.env; enabling it without an endpoint
# is a deliberate startup failure.
Environment=ASH_TRACING_ENABLED=false
Environment=ASH_TRACING_SAMPLE_RATIO=1.0
# Same independent OTLP log export switch as the consumer. Add
# ASH_LOG_OTLP_ENABLED=true and ASH_OTLP_LOGS_ENDPOINT to /etc/ash/api.env
# to ship logs to the collector; enabling it without an endpoint fails
# startup rather than silently dropping logs.
Environment=ASH_LOG_OTLP_ENABLED=false

# Placeholder default; override by adding ASH_DATABASE_URL to
# /etc/ash/api.env once Postgres is provisioned (install.sh cannot
# generate this safely on its own since it does not create the Postgres
# role) — EnvironmentFile= below is listed after these Environment= lines
# so a value set in api.env takes precedence, per systemd's file-order
# override rules.
Environment=ASH_DATABASE_URL=postgresql://ash:password@localhost/ash_logs
Environment=ASH_API_PORT=8080
# ASH_JWT_SECRET and ASH_ADMIN_PASS are generated at install time into
# /etc/ash/api.env (see scripts/install.sh: generate_api_secrets) instead
# of being committed here with a fixed, publicly-known value — the
# previous "change-me-in-production" literal was a real credential once
# deployed as-is, since it matches the source-visible default in
# api_server.py and would let anyone forge admin JWTs.
EnvironmentFile=-/etc/ash/api.env

ProtectSystem=strict
ReadWritePaths=/var/log/ash
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
